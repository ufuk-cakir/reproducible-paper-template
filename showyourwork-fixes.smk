"""Fixes for the pinned showyourwork under Snakemake 9. Owned by the template.

Do not edit this file in a paper repository; template updates replace it.
The Snakefile includes it before any paper rule.
"""

# showyourwork deletes its DAG checkpoint flag on every build. Snakemake 9 then
# plans "no update" for files whose inputs changed, so an edited \input file or
# a regenerated result would not reach the PDF. Requesting the flag directly
# makes the checkpoint resolve on every build. The cost: every build recompiles
# the LaTeX once, even when nothing changed. Figure scripts still rerun only
# when their inputs change.
if workflow.is_rule("syw__main"):
    workflow.get_rule("syw__main").set_input(workflow.get_rule("syw__dag").output)
