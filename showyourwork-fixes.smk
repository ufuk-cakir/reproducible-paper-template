"""Fixes for the pinned showyourwork under Snakemake 9. Owned by the template.

Do not edit this file in a paper repository; template updates replace it.
The Snakefile includes it before any paper rule.
"""

from showyourwork import config as syw_config
from showyourwork import paths as syw_paths

# 1. showyourwork deletes its DAG checkpoint flag on every build. Snakemake 9
#    then plans "no update" for files whose inputs changed, so an edited \input
#    file or a regenerated result would not reach the PDF. Requesting the flag
#    directly makes the checkpoint resolve on every build. Figure scripts still
#    rerun only when their inputs change.
if workflow.is_rule("syw__main"):
    workflow.get_rule("syw__main").set_input(workflow.get_rule("syw__dag").output)


# 2. At the checkpoint, showyourwork's dependency walker expands directories
#    again for every path that reaches them, with no record of what it has
#    already visited. Its cost grows as .showyourwork/ fills up: a no-change
#    build of the example paper took about 50 s instead of 8 s. This walk visits
#    each node once and expands only directories that no rule writes. Defining
#    the function here replaces the one showyourwork imported into the workflow.
def get_upstream_dependencies(file, dependencies, depth=0):
    repo = syw_paths.user().repo
    visited = {file}
    upstream = set()
    pending = list(dependencies.get(file, []))
    while pending:
        dependency = pending.pop()
        if dependency in visited:
            continue
        visited.add(dependency)
        if dependency in dependencies:
            upstream.add(dependency)
            pending.extend(dependencies[dependency])
        else:
            expanded = syw_config.expand_dependency_directories(dependency, repo_root=repo)
            upstream.update(path for path in expanded if path != file)
            pending.extend(path for path in expanded if path in dependencies)
    return sorted(upstream) if depth == 0 else upstream
